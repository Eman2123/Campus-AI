ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# Admin role-gating (Day 34) - the only way a user becomes an admin.
# Leave empty and nobody can reach /api/admin/* routes. Same JSON-array
# format as CORS_ORIGINS.
ADMIN_EMAILS=[]

# Neon Postgres — use the "postgresql+asyncpg://" scheme, not the plain
# "postgresql://" string Neon's dashboard gives you.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Document storage (Day 16) - local disk path
UPLOAD_DIR=./uploads

# Redis (Upstash or local) — used for session cache + LangGraph checkpointing
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Wired in from Phase 2 (Day 5+) onward
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini
ASSEMBLYAI_API_KEY=

# Observability (Day 15) - optional, leave blank to skip LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=campus-ai

# RAG pipeline (Day 17) - defaults are fine, override if using a
# different embedding model or want bigger/smaller chunks
AIML_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# Email (Day 20) - Resend. Leave RESEND_API_KEY blank to use the stub
# (logs what would have been sent instead of actually emailing).
RESEND_API_KEY=
EMAIL_FROM=Campus AI <onboarding@resend.dev>

# Deadline Reminders (Day 20) - defaults are fine for most setups
REMINDER_LEAD_TIME_HOURS=48
REMINDER_CHECK_HOUR_UTC=13

# Email Digest (Day 22) - defaults are fine for most setups
DIGEST_LOOKAHEAD_DAYS=7
DIGEST_CHECK_HOUR_UTC=8

# File Organizer (Day 23) - leave GOOGLE_SERVICE_ACCOUNT_FILE blank to
# skip Drive filing (subject tagging still works without it)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Campus AI

# Streaming chat (Day 30) - typewriter pacing for the chunked SSE
# delivery in POST /api/chat/stream. Defaults are fine for most setups.
STREAM_CHUNK_WORDS=3
STREAM_CHUNK_DELAY_MS=40
