ENV=development
# In production set ENV=production: the app then refuses to start with a weak
# JWT_SECRET_KEY (needs 32+ chars, e.g. `openssl rand -hex 32`).

# Apply Alembic migrations automatically at startup. Turn on for hosts without
# a separate migration step (FastAPI Cloud). Safe to leave on: a no-op once
# the database is up to date.
RUN_MIGRATIONS_ON_STARTUP=false
CORS_ORIGINS=["http://localhost:3000"]

# Admin role-gating (Day 34) - the only way a user becomes an admin.
# Leave empty and nobody can reach /api/admin/* routes. Same JSON-array
# format as CORS_ORIGINS.
ADMIN_EMAILS=[]

# Neon Postgres — paste the connection string exactly as Neon shows it
# (postgresql://...?sslmode=require&channel_binding=require); the app converts
# it to the asyncpg form itself.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Document storage (Day 16) - local disk path
UPLOAD_DIR=./uploads

# Redis (Upstash or local) — used for session cache + LangGraph checkpointing
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Sign-in form's "Remember me" - lifetime of that longer token, in days
REMEMBER_ME_EXPIRE_DAYS=30

# Password reset - the emailed link opens FRONTEND_URL/reset-password?token=...
# and works once, for this many minutes. With RESEND_API_KEY blank the email
# is only logged (see Email below), so copy the link from the server log.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# "Continue with Google" - OAuth *Web client ID* from Google Cloud Console
# (APIs & Services > Credentials). Use the same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to switch Google sign-in off.
GOOGLE_CLIENT_ID=

# Wired in from Phase 2 (Day 5+) onward
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini
ASSEMBLYAI_API_KEY=
# Optional: spoken replies (Read aloud + voice chat). Leave blank to hide the feature.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Observability (Day 15) - optional, leave blank to skip LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=campus-ai

# RAG pipeline (Day 17) - defaults are fine, override if using a
# different embedding model or want bigger/smaller chunks
AIML_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# Email (Day 20) - Resend. Leave RESEND_API_KEY blank to use the stub
# (logs what would have been sent instead of actually emailing).
RESEND_API_KEY=
EMAIL_FROM=Campus AI <onboarding@resend.dev>

# Deadline Reminders (Day 20) - defaults are fine for most setups
REMINDER_LEAD_TIME_HOURS=48
REMINDER_CHECK_HOUR_UTC=13

# Email Digest (Day 22) - defaults are fine for most setups
DIGEST_LOOKAHEAD_DAYS=7
DIGEST_CHECK_HOUR_UTC=8

# File Organizer (Day 23) - leave GOOGLE_SERVICE_ACCOUNT_FILE blank to
# skip Drive filing (subject tagging still works without it)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Campus AI

# Streaming chat (Day 30) - typewriter pacing for the chunked SSE
# delivery in POST /api/chat/stream. Defaults are fine for most setups.
STREAM_CHUNK_WORDS=3
STREAM_CHUNK_DELAY_MS=40

# --- Tests ---
# Tests create users/documents/schedules, so they must NOT run against your
# real database. Point them at a separate throwaway one (e.g. a Neon branch).
# pytest refuses to start if DATABASE_URL is remote and this is not set.
# TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/campus_ai_test

# Docker/Render only: which proxies may set X-Forwarded-For so the rate limiter sees real client IPs.
# "*" is safe only if the host strips client-supplied X-Forwarded-For (Render does). See DEPLOY.md.
# FORWARDED_ALLOW_IPS=*
