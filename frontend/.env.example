# Base URL of the FastAPI backend (see ../backend). Consumed by lib/api.ts —
# every auth call (sign in, sign up, password reset, dashboard) goes through it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: "Continue with Google". Use the OAuth *Web client ID* from Google
# Cloud Console and add http://localhost:3000 under "Authorised JavaScript
# origins". Must be the same value as GOOGLE_CLIENT_ID in the backend's .env.
# Leave blank and the Google button is simply not shown.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public address of this site, used for canonical links, the sitemap and the
# social preview image. Set it to your real domain in production
# (e.g. https://campus-ai.vercel.app), no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Country whose law governs the Terms (e.g. Pakistan). Leave blank to omit the
# "Governing law" section until you have decided it with a lawyer.
NEXT_PUBLIC_GOVERNING_LAW=

# There is intentionally no contact email variable: people reach you through
# /contact, and the destination address lives on the backend (CONTACT_EMAIL),
# so it never appears on a page or in the JavaScript bundle.
