# Base URL of the FastAPI backend (see ../backend). Consumed by lib/api.ts —
# every auth call (sign in, sign up, password reset, dashboard) goes through it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: "Continue with Google". Use the OAuth *Web client ID* from Google
# Cloud Console and add http://localhost:3000 under "Authorised JavaScript
# origins". Must be the same value as GOOGLE_CLIENT_ID in the backend's .env.
# Leave blank and the Google button is simply not shown.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
